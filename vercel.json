{
  "version": 2,
  "builds": [
    {"src": "api/index.py", "use": "@vercel/python"}
  ],
  "rewrites": [
    {"source": "/", "destination": "/api/index.py"},
    {"source": "/about", "destination": "/api/index.py"},
    {"source": "/how-it-works", "destination": "/api/index.py"},
    {"source": "/features", "destination": "/api/index.py"},
    {"source": "/pricing", "destination": "/api/index.py"},
    {"source": "/contact", "destination": "/api/index.py"},
    {"source": "/api/:path*", "destination": "/api/index.py"},
    {"source": "/auth", "destination": "/api/index.py"},
    {"source": "/auth/:path*", "destination": "/api/index.py"},
    {"source": "/admin", "destination": "/api/index.py"},
    {"source": "/admin/:path*", "destination": "/api/index.py"},
    {"source": "/app", "destination": "/api/index.py"},
    {"source": "/app/:path*", "destination": "/api/index.py"}
  ],
  "headers": [
    {
      "source": "/static/(.*)",
      "headers": [{"key":"Cache-Control","value":"public, max-age=31536000, immutable"}]
    }
  ]
}
