{
  "builds": [
    {"src": "api/index.py", "use": "@vercel/python"}
  ],
  "routes": [
    {"src": "/static/(.*)", "dest": "/static/$1"},
    {"src": "/favicon.ico", "dest": "/static/favicon.ico"},
    {"src": "/(.*)", "dest": "api/index.py"}
  ],
  "headers": [
    {
      "source": "/static/(.*)",
      "headers": [
        {"key": "Cache-Control", "value": "public, max-age=31536000, immutable"}
      ]
    }
  ]
}
