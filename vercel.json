{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "cleanUrls": true,
  "functions": {
    "api/index.py": {
      "maxDuration": 60
    }
  },
  "git": {
    "deploymentEnabled": {
      "*": false,
      "master-branch": true
    }
  },
  "github": {
    "autoAlias": false
  }
}
