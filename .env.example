# Server-side secrets only. Never use NEXT_PUBLIC_OPENAI_API_KEY or NEXT_PUBLIC_NVIDIA_API_KEY.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TIMEOUT_SECONDS=15

# Runtime AI failover. The Next.js /api/ai/generate route tries providers in this order.
# A 408, 429, 5xx, timeout, or unavailable provider moves to the next configured provider.
INTELLIHIRE_AI_PROVIDER=openai
INTELLIHIRE_AI_FALLBACK_PROVIDERS=nvidia
INTELLIHIRE_AI_PROVIDER_ORDER=openai,nvidia

# OpenAI fallback/primary provider.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1

# NVIDIA API-compatible fallback/primary provider.
NVIDIA_API_KEY=
NVIDIA_MODEL=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

INTELLIHIRE_PROMPT_VERSION=v1
INTELLIHIRE_AI_RATE_LIMIT_PER_MINUTE=30
TAVILY_API_KEY=
FLASK_SECRET_KEY=
DATABASE_URL=
