# Server-side secrets only. Never use NEXT_PUBLIC_DEEPSEEK_API_KEY.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TIMEOUT_SECONDS=15

# Automatic failover: try DeepSeek first, then the first configured fallback.
# You may set an explicit order, e.g. deepseek,openai,nvidia.
INTELLIHIRE_AI_PROVIDER=deepseek
INTELLIHIRE_AI_FALLBACK_PROVIDERS=openai,nvidia
INTELLIHIRE_AI_PROVIDER_ORDER=deepseek,openai,nvidia

# Optional fallback provider credentials/models.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1
NVIDIA_API_KEY=
NVIDIA_MODEL=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

INTELLIHIRE_PROMPT_VERSION=v1
INTELLIHIRE_AI_RATE_LIMIT_PER_MINUTE=30
TAVILY_API_KEY=
FLASK_SECRET_KEY=
DATABASE_URL=
